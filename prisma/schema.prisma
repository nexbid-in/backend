generator client {
  provider = "prisma-client"
  output   = "../src/infrastructure/database/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id
  email        String    @unique
  mobile       String?
  profileImage String?
  isBlocked    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  firstName    String
  googleId     String?   @unique
  lastName     String
  password     String
  role         Role      @default(USER)
  lastActiveAt DateTime?
}

enum Role {
  USER
  ADMIN
}
