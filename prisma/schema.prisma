
generator client {
  provider = "prisma-client"
  output   = "../src/infrastructure/generated/prisma"
}

datasource db {
  provider = "postgresql"
}



model User {
  // Core Identity
  id           String   @id
  email        String   @unique
  firstName    String
  lastName     String
  password     String

  // Optional Profile Info
  mobile       String?  
  profileImage String?
  googleId     String?  @unique

  // Account Status
  isBlocked    Boolean @default(false)

  // Metadata
  createdAt    DateTime @default(now())
}


