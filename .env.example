# ==========================================
# Application & Server
# ==========================================
NODE_ENV=development
PORT=7000
CLIENT_URL=http://localhost:5173

# ==========================================
# Database (PostgreSQL)
# ==========================================
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/nexbid_dev?schema=public

# ==========================================
# Cache & Message Broker (Redis)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ==========================================
# Authentication & JWT (Min 32 characters)
# ==========================================
JWT_SECRET=your_super_secret_jwt_access_key_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# Email & SMTP (Nodemailer)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM="NexBid <no-reply@nexbid.in>"

# ==========================================
# Google OAuth
# ==========================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ==========================================
# Cloudinary (Media Storage)
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==========================================
# Financial & Virtual Economy
# ==========================================
VIRTUAL_CURRENCY_RATE=10

# ==========================================
# Payment Gateway (Razorpay)
# ==========================================
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# =============================================================
# MARKET DATA PROVIDER (FYERS API v3)
# =============================================================
MARKET_DATA_PROVIDER=mock   # Options: "mock" (simulated realistic price ticks & candles for local dev) or "fyers" (live market data)
FYERS_APP_ID=your_fyers_app_id     
FYERS_SECRET_KEY=your_secret_key

# Automated Headless Authentication Credentials (2FA TOTP)
FYERS_USER_ID=your_fyers_client_id
FYERS_PIN=your_4_digit_pin
FYERS_TOTP_KEY=your_totp_secret_key

# Optional: Defaults to "https://trade.fyers.in/api-login/redirect-uri/index.html" if omitted
FYERS_REDIRECT_URI=https://trade.fyers.in/api-login/redirect-uri/index.html

# Optional: Emergency manual override. Leave blank if using automated headless authentication.
# When blank, tokens are automatically generated, stored in Redis, and refreshed daily at 06:15 AM IST.
FYERS_ACCESS_TOKEN=

